    },
    {
      "id": "regeneration",
      "evidence": "Scripts/prepare_character_creator.py: prepare",
      "cause": "Every preparation overwrites Male.Standard/Female.Standard and hair references, even when a better catalog exists."
    },
    {
      "id": "green-height",
      "evidence": "Scripts/gis/build_meshes.py: generate",
      "cause": "Green polygons use the maximum perimeter elevation for every triangle rather than the DEM at each vertex; verify intersecting candidates below."
    },
    {
      "id": "cell-bounds",
      "evidence": "Scripts/gis/build_meshes.py: triangle; Scripts/gis/build_playable_district.py: sidewalk triangulation",
      "cause": "Triangles are assigned by centroid without clipping to cells, so actual bounds can exceed the claimed 128 m sector."
    },
    {
      "id": "trees",
      "evidence": "Scripts/assets/build_start_location_models.py: tree",
      "cause": "Leaf faces are flat kite-shaped quads with generic planar UVs and no leaf silhouette mask."
    }
